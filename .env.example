GROQ_API_KEY=
TEXT_MODEL=qwen/qwen3.8-27b
PORT=3200
HOST=127.0.0.1
# Optional custom login username; defaults to steno.
APP_USERNAME=steno
# Required when HOST is not loopback.
APP_PASSWORD=
# Required for hosting: the public HTTPS URL, without trailing slash.
PUBLIC_ORIGIN=
# Server-side dictionary database. Hosting must use a mounted persistent volume.
DICTIONARY_PATH=data/steno.sqlite
